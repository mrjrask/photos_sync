<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jason.photosnassync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jason/photos_sync/sync_photos.sh</string>
    </array>

    <!-- Runs once a day at 3:00 AM -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Also runs once whenever this agent (re)loads, e.g. at login,
         so you're not stuck waiting until 3 AM to catch up. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jason/Library/Logs/photos-nas-sync.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jason/Library/Logs/photos-nas-sync.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
